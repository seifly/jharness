<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.seifly.jharness</groupId>
        <artifactId>plugins</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>tools-plugin</artifactId>
    <name>tools-plugin</name>
    <description>工具集成插件</description>

    <properties>
        <plugin.id>tools-plugin</plugin.id>
        <plugin.class>cn.seifly.jharness.plugins.tools.ToolsPlugin</plugin.class>
        <plugin.version>1.0.0</plugin.version>
        <plugin.provider>seifly</plugin.provider>
        <plugin.description>Tool：Agent 能做什么？</plugin.description>
    </properties>

    <dependencies>
        <!-- HTTP 客户端（WebFetchTool / WebSearchTool / SocialNetworkTool） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- JSON 处理（WebFetchTool / WebSearchTool / SocialNetworkTool / TokenUsageStore / MCPTool） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
          跨插件依赖（编译期）：
          StreamAwareTool / ToolRegistry / CollaborateTool / SubagentManager / SpawnTool 引用
          models-plugin 中的 LLMProvider / ToolDefinition / Message / StreamEvent 类。
          注意：PF4J 每个插件独立类加载器，运行期该依赖无法直接共享类，
          需在后续统一调整时，将共享数据结构提升至 plugin-framework 共享 SDK。
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>models-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          跨插件依赖（编译期）：
          SkillsTool 引用 skills-plugin 中的 SkillsLoader / SkillsInstaller / SkillsSearcher / SkillInfo / SkillRegistry
          以及 skills-plugin 内部配置 SkillsToolConfig。
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>skills-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          跨插件依赖（编译期）：
          SubagentManager 引用 sessions-plugin 中的 SessionManager。
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sessions-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          跨插件依赖（编译期）：
          CronTool 引用 CronService / CronJob / CronSchedule。
          注意：PF4J 每个插件独立类加载器，运行期该依赖无法直接共享类，
          需在后续统一调整时，将共享数据结构提升至 plugin-framework 共享 SDK。
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>cron-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
