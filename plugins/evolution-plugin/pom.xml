<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.seifly.jharness</groupId>
        <artifactId>plugins</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>evolution-plugin</artifactId>
    <name>evolution-plugin</name>
    <description>自我进化插件</description>

    <properties>
        <plugin.id>evolution-plugin</plugin.id>
        <plugin.class>cn.seifly.jharness.plugins.evolution.EvolutionPlugin</plugin.class>
        <plugin.version>1.0.0</plugin.version>
        <plugin.provider>seifly</plugin.provider>
        <plugin.description>Evolution：Agent 自我进化</plugin.description>
    </properties>

    <dependencies>
        <!-- HTTP 客户端（PromptOptimizer 调用 LLM） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- JSR310 时间类型支持（FeedbackManager / VariantManager 持久化） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!--
          跨插件依赖（编译期）：
          FeedbackManager / PromptOptimizer 引用 models-plugin 的 LLMProvider / LLMResponse / Message。
          注意：PF4J 每个插件独立类加载器，运行期该依赖无法直接共享类，
          需在后续统一调整时，将共享数据结构提升至 plugin-framework 共享 SDK。
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>models-plugin</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!--
          TODO 跨插件依赖（待 config 分散到各插件后处理）：
          FeedbackManager / PromptOptimizer / VariantManager 引用 config.Config / EvolutionConfig。
        -->
    </dependencies>
</project>
