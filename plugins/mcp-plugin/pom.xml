<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.seifly.jharness</groupId>
        <artifactId>plugins</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mcp-plugin</artifactId>
    <name>mcp-plugin</name>
    <description>MCP 协议插件</description>

    <properties>
        <plugin.id>mcp-plugin</plugin.id>
        <plugin.class>cn.seifly.jharness.plugins.mcp.MCPPlugin</plugin.class>
        <plugin.version>1.0.0</plugin.version>
        <plugin.provider>seifly</plugin.provider>
        <plugin.description>MCP：Model Context Protocol 客户端</plugin.description>
    </properties>

    <dependencies>
        <!-- HTTP 客户端（SSE/StreamableHttp MCP 客户端） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- SSE 事件解析 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
          #2 重构后已解除对 tools-plugin 的编译期依赖：
          MCPManager 原本引用的 ToolRegistry 已提升至 plugin-framework SDK 契约
          ToolService，不再 <dependency> 依赖 tools-plugin。

          TODO 跨插件依赖（待 config 分散到各插件后处理）：
          MCPManager 引用 config.Config / MCPConfig。
        -->
    </dependencies>
</project>
